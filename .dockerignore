# Build context hygiene: everything the image does not need, and anything that must
# never end up inside it.

.git
.github
.venv
venv
**/__pycache__
**/*.py[cod]
*.egg-info
.mypy_cache
.ruff_cache
.pytest_cache

tests
docs
tools
CONTRIBUTING.md
THIRD-PARTY-NOTICES.md
docker-compose.yml
Dockerfile
.dockerignore

# Secrets must never enter a build context: every file here lands in a layer, and a
# deleted file in a later layer is still present in the earlier one.
*.token
agent.token
*.pem
*.pfx
*.key
.env
*.local.toml
logs/
